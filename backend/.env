# ExamLens backend configuration. Copy to `.env` and adjust.

# --- App ---
APP_NAME=ExamLens API
API_PREFIX=/api
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- MongoDB ---
# Local:  mongodb://localhost:27017
# Docker: mongodb://mongo:27017  (service name in docker-compose)
# Atlas:  mongodb+srv://<user>:<pass>@cluster.xxxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017
DB_NAME=examlens

# --- Storage ---
# Where uploaded videos, clips and heatmaps are written (defaults to backend/storage).
# STORAGE_DIR=/data/examlens

# --- Auth (JWT) ---
# CHANGE THIS in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=c8fe6a021005f71403a37681a97209452e2b13960d87b7f34688c56ad55bcfa9
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Set to false once the first admin exists to lock down account creation.
ALLOW_OPEN_REGISTRATION=true

# --- ML / worker ---
YOLO_WEIGHTS=yolo11n.pt
WORKER_THREADS=1
TOP_CLIPS=10
# Cap frames per job for quick demos; leave unset to process the whole video.
# MAX_FRAMES=300

# --- Optional Celery (default off: jobs run in an in-process thread) ---
USE_CELERY=false
CELERY_BROKER_URL=redis://localhost:6379/0
